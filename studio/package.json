{
  "name": "neosr-studio",
  "version": "0.0.0",
  "scripts": {
    "start": "concurrently -n web,api -c cyan,magenta \"npm:web\" \"npm:api\"",
    "web": "ng serve --proxy-config proxy.conf.json --port 4300",
    "api": "tsx watch server/index.ts",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "ng test",
    "ng": "ng"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@foblex/flow": "^19.4.0",
    "echarts": "^6.1.0",
    "express": "^5.3.0",
    "rxjs": "~7.8.0",
    "smol-toml": "^1.9.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
